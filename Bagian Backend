# Google Sheet setup
def get_google_sheet():
    scope = ['https://spreadsheets.google.com/feeds',
             'https://www.googleapis.com/auth/drive']
    # You need to download your service account key
    creds = ServiceAccountCredentials.from_json_keyfile_name('credentials.json', scope)
    client = gspread.authorize(creds)
    sheet = client.open('TicketSystem').sheet1
    return sheet

# Simple Ticket Factory Pattern
class Ticket:
    def __init__(self, kategori, data):
        self.kategori = kategori
        self.data = data
        self.status = 'Open'
        self.created_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.logs = [f"Tiket dibuat oleh Client pada {self.created_at}"]

class TechTicket(Ticket):
    def __init__(self, data):
        super().__init__('Technical', data)

class CSTicket(Ticket):
    def __init__(self, data):
        super().__init__('CS', data)

class BillingTicket(Ticket):
    def __init__(self, data):
        super().__init__('Billing', data)

class TicketFactory:
    @staticmethod
    def create(kategori, data):
        if kategori == 'Technical':
            return TechTicket(data)
        elif kategori == 'CS':
            return CSTicket(data)
        elif kategori == 'Billing':
            return BillingTicket(data)
        else:
            return Ticket(kategori, data)

