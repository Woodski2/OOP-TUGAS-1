@app.route('/api/create_ticket', methods=['POST'])
def create_ticket():
    global ticket_counter
    data = request.json
    kategori = data.get('kategori')
    deskripsi = data.get('deskripsi')
    
    # Factory pattern implementation
    ticket_data = {
        'deskripsi': deskripsi,
        'created_by': data.get('nama', 'Anonymous')
    }
    ticket = TicketFactory.create(kategori, ticket_data)
    
    # Store ticket
    ticket_id = ticket_counter
    tickets_db[ticket_id] = {
        'id': ticket_id,
        'kategori': ticket.kategori,
        'deskripsi': deskripsi,
        'status': ticket.status,
        'created_at': ticket.created_at,
        'logs': ticket.logs,
        'nama': data.get('nama', 'Anonymous')
    }
    ticket_counter += 1
    
    # Save to Google Sheet (optional)
    # try:
    #     sheet = get_google_sheet()
    #     sheet.append_row([ticket_id, ticket.kategori, deskripsi, ticket.status, ticket.created_at])
    # except:
    #     pass
    
    return jsonify({'success': True, 'ticket_id': ticket_id, 'ticket': tickets_db[ticket_id]})

@app.route('/api/update_ticket/<int:ticket_id>', methods=['POST'])
def update_ticket(ticket_id):
    data = request.json
    action = data.get('action')
    
    if ticket_id in tickets_db:
        old_status = tickets_db[ticket_id]['status']
        
        if action == 'resolve':
            tickets_db[ticket_id]['status'] = 'Closed'
        elif action == 'reject':
            tickets_db[ticket_id]['status'] = 'Rejected'
        
        log_entry = f"Admin {action} tiket, status berubah dari {old_status} menjadi {tickets_db[ticket_id]['status']} pada {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
        tickets_db[ticket_id]['logs'].append(log_entry)
        
        return jsonify({'success': True, 'ticket': tickets_db[ticket_id]})
    
    return jsonify({'success': False, 'error': 'Ticket not found'})

@app.route('/api/get_tickets')
def get_tickets():
    return jsonify({'tickets': tickets_db})

